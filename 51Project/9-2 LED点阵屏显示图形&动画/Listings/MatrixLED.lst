  87   2              // 或者：
  88   2              // SER = (Byte >> i) & 0x01;        // 从低位到高位发送
  89   2              }
  90   1          RCK = 1;                           // 锁存时钟上升沿
  91   1          RCK = 0;                           // 拉低，数据锁存完成
