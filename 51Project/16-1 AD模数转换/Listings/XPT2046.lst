line level    source

   1          #include <REGX52.H>
   2          
   3          sbit XPT2046_CS = P3^5;    // CS: 片选信号（选中芯片）
   4          sbit XPT2046_DCLK = P3^6;  // DCLK: 时钟信号
   5          sbit XPT2046_DIN = P3^4;   // DIN: 数据输入（单片机→芯片）
   6          sbit XPT2046_DOUT = P3^7;  // DOUT: 数据输出（芯片→单片机）
   7          
   8          /*
   9          位:    D7  D6  D5  D4  D3  D2  D1  D0
  10                S   A2  A1  A0  MODE SER/DFR PD1 PD0
  11          
  12          
  13          常用命令：
  14          0x94 = 1001 0100 → 读取X坐标
  15          0xD4 = 1101 0100 → 读取Y坐标
  16          
  17          1. CS拉低 → 选中芯片
  18          2. 发送8位命令 → 告诉芯片要读X还是Y
  19          3. 芯片转换 → 需要等待（代码中没有）
  20          4. 读取16位数据 → 得到原始AD值
  21          5. 右移4位 → 得到12位有效数据（0-4095）
  22          6. CS拉高 → 结束通信
  23          */
  24          unsigned int XPT2046_Read(unsigned char Command){
  25   1              unsigned char i;
  26   1              unsigned int ADVAlue=0; // ✅ 初始化为0
  27   1      
  28   1          XPT2046_CS = 0;        // 选中芯片
  29   1          XPT2046_DCLK = 0;      // 时钟初始为低
  30   1      
  31   1          // 发送命令（8位）
  32   1              for(i=0;i<8;i++){
  33   2             // 发送数据位（从高位开始）
  34   2                      XPT2046_DIN=Command & (0x80 >> i); // 1111 0000 对高位置1
  35   2                      XPT2046_DCLK = 1;  // 时钟上升沿，芯片读取数据位
  36   2                      XPT2046_DCLK = 0;  // 时钟恢复低电平
  37   2              }
  38   1              //读取数据部分
  39   1              for(i=0;i<16;i++){
  40   2                      XPT2046_DCLK = 1;   // 时钟上升沿，芯片输出数据
  41   2                      XPT2046_DCLK = 0;   // 时钟下降沿
  42   2                      if(XPT2046_DOUT){ADVAlue |= (0x8000 >> i);}
  43   2              }
  44   1              
  45   1              XPT2046_CS=1;  //CS拉高 → 结束通信
  46   1              
  47   1              if(Command & 0x08){     // 检查命令的第3位（D3）
  48   2                      return ADVAlue >> 8;  // 12位模式：右移8位，保留高4位？可能有误
  49   2              } else {
  50   2                      return ADVAlue >> 4;  // 12位模式：右移4位，得到12位有效数据
  51   2              }
  52   1              
  53   1      }

