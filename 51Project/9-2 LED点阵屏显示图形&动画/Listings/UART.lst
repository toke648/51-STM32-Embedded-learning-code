   1          #include <REGX52.H>
   2          
   3          /**
   4            * @brief  串口初始化 //4800bps@12.000MHz
   5            * @param  无
   6            * @param  无
   7            * @retval 
   8            */
   9          
  10          void UART_Init(){
  11   1              // 40是使能，50是不使能
  12   1              // 使用电脑发送数据，改为不使能
  13   1              SCON = 0x50;            //8位数据,可变波特率
  14   1              PCON |= 0x80;           //使能波特率倍速位SMOD
  15   1              TMOD &= 0x0F;           //清除定时器1模式位
  16   1              TMOD |= 0x20;           //设定定时器1为8位自动重装方式
  17   1              TL1 = 0xF3;             //设定定时初值
  18   1              TH1 = 0xF3;             //设定定时器重装值
  19   1              ET1 = 0;                //禁止定时器1中断
  20   1              TR1 = 1;                //启动定时器1
  21   1              EA=1; //启动所有中断
  22   1              ES=1; //启动串口中断
  23   1      }
  24          
  25          /**
  26            * @brief  串口发送一个字节的数据
  27            * @param  Byte 要发送的一个字节的数据
  28            * @param  无
  29            * @retval 
  30            */
  31          void UART_SendByte(unsigned char Byte)
  32          {
  33   1              SBUF=Byte; //串口缓冲数据寄存器SBUF
  34   1              while(TI==0); //判断是否为零（即是否有数据）
  35   1              TI=0;
  36   1      }
