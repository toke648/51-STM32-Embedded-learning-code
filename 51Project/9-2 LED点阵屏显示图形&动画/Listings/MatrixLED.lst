  72          void _74HC595_WriteByte(unsigned char Byte){
  73   1              unsigned char i;
  74   1              P2=~Byte;
  75   1              for(i=0;i<8;i++){
  76   2      //              SER=Byte&0x80;
  77   2                      //P2=~Byte; //这行放在循环里，每次移位都会刷新P2口8次，应该删除或移到循环外
             -。
  78   2      //              SER=Byte&(0x80>>i); //每次循环移位一位
